{
  "name": "@loomdesk/agentkit",
  "version": "0.1.0",
  "description": "Coinbase AgentKit action provider for LoomDesk: liquidity ladders, limit orders and pools on Robinhood Chain (4663), planned by loomdesk.trade, checked and signed by the agent's own wallet.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "keywords": ["agentkit", "coinbase-agentkit", "action-provider", "loomdesk", "robinhood-chain", "uniswap-v4", "liquidity", "defi", "ai-agent"],
  "homepage": "https://loomdesk.trade/llms.txt",
  "repository": { "type": "git", "url": "git+https://github.com/loomdesk/loomdesk-agents.git", "directory": "packages/agentkit" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.check.json",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "dry-run": "npm run build && node scripts/dry-run.mjs"
  },
  "peerDependencies": {
    "@coinbase/agentkit": ">=0.10.4 <0.12.0",
    "reflect-metadata": "^0.2.2",
    "viem": "^2.38.3",
    "zod": "^3.23.8 || ^4.0.0"
  },
  "devDependencies": {
    "@coinbase/agentkit": "0.10.4",
    "@types/node": "^22.0.0",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.9.0",
    "viem": "2.38.3",
    "zod": "^3.23.8"
  },
  "engines": { "node": ">=20" }
}
