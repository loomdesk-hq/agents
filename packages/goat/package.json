{
  "name": "@loomdesk/goat-plugin",
  "version": "0.1.0",
  "description": "GOAT SDK plugin for LoomDesk: liquidity ladders, limit orders and pools on Robinhood Chain (4663), planned by loomdesk.trade, checked and signed by the agent's own EVM wallet.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "keywords": ["goat", "goat-sdk", "goat-plugin", "loomdesk", "robinhood-chain", "uniswap-v4", "liquidity", "defi", "ai-agent"],
  "homepage": "https://loomdesk.trade/llms.txt",
  "repository": { "type": "git", "url": "git+https://github.com/loomdesk/loomdesk-agents.git", "directory": "packages/goat" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.check.json",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "dry-run": "npm run build && node scripts/dry-run.mjs"
  },
  "peerDependencies": {
    "@goat-sdk/core": ">=0.4.6 <0.6.0",
    "@goat-sdk/wallet-evm": ">=0.2.0 <0.4.0",
    "reflect-metadata": "^0.2.2",
    "viem": ">=2.21.0 <3",
    "zod": ">=3.23.0 <4"
  },
  "devDependencies": {
    "@goat-sdk/core": "0.5.0",
    "@goat-sdk/wallet-evm": "0.3.0",
    "@goat-sdk/wallet-viem": "0.3.0",
    "@types/node": "^22.0.0",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.9.0",
    "viem": "2.23.4",
    "zod": "3.23.8"
  },
  "engines": { "node": ">=20" }
}
