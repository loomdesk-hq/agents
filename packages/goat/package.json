{
  "name": "loomdesk-goat",
  "version": "0.1.0",
  "description": "LoomDesk for GOAT agents: the market on Robinhood Chain, and real liquidity ladders planned by loomdesk.trade, checked, and sent from the agent's own wallet.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "goat",
    "goat-sdk",
    "goat-plugin",
    "loomdesk",
    "robinhood-chain",
    "uniswap-v4",
    "liquidity",
    "defi",
    "ai-agent"
  ],
  "homepage": "https://loomdesk.trade/agents/start",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loomdesk-hq/agents.git",
    "directory": "packages/goat"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.check.json",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "dry-run": "npm run build && node scripts/dry-run.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@goat-sdk/core": ">=0.4.6 <0.6.0",
    "@goat-sdk/wallet-evm": ">=0.2.0 <0.4.0",
    "reflect-metadata": "^0.2.2",
    "viem": ">=2.21.0 <3",
    "zod": ">=3.23.0 <4"
  },
  "devDependencies": {
    "@goat-sdk/core": "0.5.0",
    "@goat-sdk/wallet-evm": "0.3.0",
    "@goat-sdk/wallet-viem": "0.3.0",
    "@types/node": "^22.0.0",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.9.0",
    "viem": "2.23.4",
    "zod": "3.23.8"
  },
  "engines": {
    "node": ">=20"
  }
}
